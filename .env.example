# Copy to .env and edit. Every value below is optional -- the defaults shown are
# what the code uses when the variable is absent, so an empty .env is a working
# configuration. .env is gitignored; .env.example is not.
#
# Precedence: shell environment > .env > built-in default. So
# `BITNET_THREADS=8 ./start.sh` overrides whatever this file says.

# === The one you should actually set ===

# Require this key on every /v1 route, sent as `Authorization: Bearer <key>`.
# Unset means no authentication: anything that can reach the container on the
# proxy network can use the API. Generate one with `openssl rand -hex 32`.
#
# Also gates the /mcp endpoint, which unlike /v1 refuses to serve at all while
# this is unset. Set it if you want to use this model from an MCP client.
#BITNET_API_KEY=

# === Deployment: read by start.sh, not by the container ===

# The external network to join, and the address to take on it. These defaults
# match an nginx-proxy-manager stack; start.sh verifies the network exists and
# that the container actually received this address.
#NETWORK=nginx-proxy-manager_default
#STATIC_IP=172.22.0.25

# Publish the API on a host port as well. Empty means the container is only
# reachable on the proxy network, so localhost will not reach it.
#HOST_PORT=8010

#IMAGE=bitnet-2b-api
#CONTAINER=bitnet-2b

# === Performance ===

# Inference threads. 4 is a conservative default, not a measured one -- see the
# note in README.md. Measure on this host before changing it.
#BITNET_THREADS=4

# Context window, in tokens. Also the cap on max_tokens, and what the UI shows.
#BITNET_CTX_SIZE=4096

# Repetition penalty. llama-server's own default is 1.0 -- no penalty -- which
# makes this 2B model loop, restating the same sentence until it runs out of
# tokens. 1.1 is the smallest value that reliably stops that. Above ~1.2 costs
# fluency, since legitimate repetition gets punished too.
#BITNET_REPEAT_PENALTY=1.1
#BITNET_REPEAT_LAST_N=64

# === Timeouts, in seconds ===

# How long a request waits for the single inference slot before getting a 503.
#BITNET_QUEUE_TIMEOUT=3

# Backend read timeout for non-streaming requests. Generous because CPU
# inference on a 2B model is slow and a low value turns a working long
# completion into a spurious 503.
#BITNET_READ_TIMEOUT=900
#BITNET_CONNECT_TIMEOUT=5

# How long entrypoint.sh waits for llama-server to come up before giving up.
# Raise it on a slow disk: the model has to be read off disk first.
#BITNET_STARTUP_TIMEOUT=120

# === Limits ===

#BITNET_MAX_MESSAGES=200
#BITNET_SESSION_TTL=86400

# === Networking inside the container ===

# The port the API listens on. The Dockerfile EXPOSEs 8010 and start.sh maps
# HOST_PORT to whatever this is set to.
#BITNET_API_PORT=8010

# Internal port for llama-server, bound to 127.0.0.1 only.
#LLAMA_SERVER_PORT=8080

# Hosts permitted to set X-Forwarded-For. Set this to the proxy's address so
# request logs record the real client. Trusting every host would let callers
# spoof their own address.
#BITNET_TRUSTED_PROXIES=127.0.0.1

# === Rarely needed ===

# Model name reported by /v1/models. Cosmetic.
#MODEL_ID=bitnet-b1.58-2B-4T

# Re-enable the pre-MDL-1 "User:" string stops. Only useful if a model revision
# stops emitting <|eot_id|>; it truncates replies that contain "User:".
#BITNET_ROLE_STOP_FALLBACK=0

# Paths inside the container.
#BITNET_STATIC_DIR=/app/static
#BITNET_DOWNLOAD_PATH=/app/downloads/download.zip
